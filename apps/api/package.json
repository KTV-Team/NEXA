{
  "name": "@nexa/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @nexa/validation build && nest build",
    "dev": "pnpm --filter @nexa/validation build && nest start --watch",
    "start": "node dist/main",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "pnpm --filter @nexa/validation build && jest",
    "test:db": "pnpm --filter @nexa/validation build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "db:migration:generate": "typeorm-ts-node-commonjs migration:generate",
    "db:migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "db:migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "db:migration:show:prod": "typeorm migration:show -d dist/database/data-source.js",
    "db:seed": "ts-node src/database/seeds/seed.ts",
    "db:seed:reset": "ts-node src/database/seeds/seed.ts --reset-fixtures",
    "test:watch": "pnpm --filter @nexa/validation build && jest --watch",
    "test:cov": "pnpm --filter @nexa/validation build && jest --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.0",
    "@nexa/types": "workspace:*",
    "@nexa/validation": "workspace:*",
    "argon2": "0.44.0",
    "dotenv": "^16.6.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "0.3.28",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/tests/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.test.json"
        }
      ]
    },
    "coverageDirectory": "<rootDir>/coverage",
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "testEnvironment": "node"
  }
}
